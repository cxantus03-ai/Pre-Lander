# ArbiScan configuration. Copy to backend/.env (local) or .env (docker compose) and edit.
# NEVER commit real credentials. All secrets stay on the backend; the frontend never sees them.

# ---- runtime ---------------------------------------------------------------
ARBISCAN_ENV=development
ARBISCAN_LOG_LEVEL=INFO
# live | demo | auto  (auto = live if an exchange API answers at start-up, else clearly-labelled DEMO data)
ARBISCAN_DATA_MODE=auto
# SQLite for local development; PostgreSQL in production, e.g.
# ARBISCAN_DATABASE_URL=postgresql+psycopg2://arbiscan:change-me@db:5432/arbiscan
ARBISCAN_DATABASE_URL=sqlite:///./arbiscan.db
# Optional Redis snapshot cache / pub-sub (leave empty to disable)
ARBISCAN_REDIS_URL=
ARBISCAN_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ARBISCAN_COLLECTOR_ENABLED=true

# ---- Polymarket (public market data: NO credentials required) ---------------
ARBISCAN_POLYMARKET_ENABLED=true
ARBISCAN_POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
ARBISCAN_POLYMARKET_CLOB_URL=https://clob.polymarket.com
ARBISCAN_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
ARBISCAN_POLYMARKET_WS_ENABLED=true
ARBISCAN_POLYMARKET_MAX_EVENTS=2000
ARBISCAN_POLYMARKET_RPS=8
# Set to true only after confirming the fee formula in app/core/fees.py against
# Polymarket's current fee documentation. Until then fee-enabled Polymarket
# opportunities are labelled ESTIMATED and never "verified".
ARBISCAN_POLYMARKET_FEE_FORMULA_VERIFIED=false

# ---- Kalshi (public REST market data: NO credentials required) --------------
ARBISCAN_KALSHI_ENABLED=true
ARBISCAN_KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
ARBISCAN_KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
ARBISCAN_KALSHI_MAX_MARKETS=20000
ARBISCAN_KALSHI_RPS=8
# Optional: enables the Kalshi WebSocket order-book feed (REST polling is used otherwise).
# Create a key at kalshi.com -> Account & security -> API Keys. Use a READ-ONLY key if offered.
# Provide EITHER a path to the downloaded private key file OR the PEM contents.
ARBISCAN_KALSHI_API_KEY_ID=
ARBISCAN_KALSHI_PRIVATE_KEY_PATH=
ARBISCAN_KALSHI_PRIVATE_KEY_PEM=

# ---- collection cadence (also adjustable at runtime in Settings) ------------
ARBISCAN_DISCOVERY_INTERVAL_S=300
ARBISCAN_BOOK_POLL_INTERVAL_S=15
ARBISCAN_MAX_WATCHED_BOOKS=400
ARBISCAN_STALE_AFTER_S=45
ARBISCAN_MAX_CLOSE_HORIZON_DAYS=400

# ---- matching ----------------------------------------------------------------
ARBISCAN_MATCH_MIN_CANDIDATE_SCORE=0.25
ARBISCAN_MATCH_MAX_CANDIDATES_PER_MARKET=5
ARBISCAN_MATCH_DATE_TOLERANCE_HOURS=24
# Optional advisory LLM second opinion on "likely" matches (never sufficient to verify). Requires `pip install anthropic`.
ARBISCAN_LLM_MATCHING_ENABLED=false
ARBISCAN_ANTHROPIC_API_KEY=
ARBISCAN_LLM_MODEL=claude-opus-5-5
ARBISCAN_LLM_MAX_REVIEWS_PER_CYCLE=20

# ---- detection defaults ------------------------------------------------------
ARBISCAN_MIN_NET_ROI_PCT=0
ARBISCAN_MIN_NET_PROFIT_USD=0
ARBISCAN_DEFAULT_BANKROLL_USD=1000
ARBISCAN_SCAN_DEBOUNCE_MS=250

# ---- history -----------------------------------------------------------------
ARBISCAN_PRICE_HISTORY_INTERVAL_S=60
ARBISCAN_SNAPSHOT_INTERVAL_S=30

# ---- optional email notifications (SMTP) -------------------------------------
ARBISCAN_SMTP_HOST=
ARBISCAN_SMTP_PORT=587
ARBISCAN_SMTP_USER=
ARBISCAN_SMTP_PASSWORD=
ARBISCAN_SMTP_FROM=
ARBISCAN_SMTP_USE_TLS=true
ARBISCAN_ALERT_COOLDOWN_S=300

# ---- demo --------------------------------------------------------------------
ARBISCAN_DEMO_SEED=
ARBISCAN_DEMO_TICK_S=2

# ---- docker compose only -------------------------------------------------------
POSTGRES_PASSWORD=change-me
